# =============================================================================
# CodeVerse - environment template (PLACEHOLDERS ONLY)
# =============================================================================
# Copy the relevant block to server/.env and client/.env.local, then fill in
# real values. NEVER commit a filled-in file.
#
# SECURITY NOTICE: earlier versions of this file contained a live MongoDB
# password and a live Gemini API key. Both were removed. If you have not
# already, ROTATE BOTH credentials in MongoDB Atlas and Google AI Studio.
# =============================================================================


# ------------------------------ BACKEND ------------------------------
# Goes in: server/.env

NODE_ENV=development
PORT=5000

# MongoDB Atlas (or a local instance)
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database-name>?retryWrites=true&w=majority

# Auth - REQUIRED. Server must exit at boot if this is missing.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<paste-a-64-character-random-hex-string>
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call the API.
# Never use '*' in production.
CORS_ORIGINS=http://localhost:3000

# Google Gemini - server-side only. Never expose to the browser.
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
# Request timeout for every Gemini call, in milliseconds.
GEMINI_TIMEOUT_MS=45000

# Rate limiting / AI budget (examples, tune freely)
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AI_RATE_LIMIT_PER_HOUR=20
AI_RATE_LIMIT_PER_DAY=200

# Firebase Admin SDK - required to verify Google/phone ID tokens.
FIREBASE_PROJECT_ID=codeverse-5f4da
FIREBASE_CLIENT_EMAIL=<service-account-email>
FIREBASE_PRIVATE_KEY=<service-account-private-key>


# ------------------------------ FRONTEND ------------------------------
# Goes in: client/.env.local

# Base URL of the API, including the /api suffix (no trailing slash).
# Local development may leave this unset (the client falls back to
# http://localhost:5000/api in development only). A production build MUST set
# it, otherwise API calls fail with API_NOT_CONFIGURED instead of silently
# calling a developer machine.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Firebase web config - Firebase Console > Project settings > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<your-project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<your-project-id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<your-project>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<app-id>
